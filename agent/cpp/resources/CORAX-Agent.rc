#include <windows.h>
#include "resource.h"

IDI_CORAX_AGENT ICON "../assets/corax-agent.ico"

1 RT_MANIFEST "CORAX-Agent.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 5,0,0,0
 PRODUCTVERSION 5,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CORAX Project\0"
      VALUE "FileDescription", "CORAX secure LAN inventory agent\0"
      VALUE "FileVersion", "5.0.0\0"
      VALUE "InternalName", "CORAX-Agent\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Timur Ivanov\0"
      VALUE "OriginalFilename", "CORAX-Agent.exe\0"
      VALUE "ProductName", "CORAX Agent\0"
      VALUE "ProductVersion", "5.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
