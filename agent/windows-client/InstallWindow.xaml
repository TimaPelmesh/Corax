<Window x:Class="Corax.Client.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corax"
        Width="460" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
  <Border x:Name="Root" CornerRadius="14" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" MouseLeftButtonDown="Drag">
    <Grid>
      <Canvas IsHitTestVisible="False">
        <Ellipse x:Name="OrbA" Width="320" Height="320" Canvas.Left="-70" Canvas.Top="-90" Fill="{DynamicResource GlowA}"/>
        <Ellipse x:Name="OrbB" Width="240" Height="240" Canvas.Left="240" Canvas.Top="10" Fill="{DynamicResource GlowB}"/>
      </Canvas>
      <StackPanel Margin="32,26,32,24">
        <DockPanel LastChildFill="False" Margin="0,0,0,14">
          <Button DockPanel.Dock="Right" Content="×" Click="Close_Click" Style="{StaticResource ChromeButton}"/>
        </DockPanel>
        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource PrimarySoft}" HorizontalAlignment="Left">
          <TextBlock Text="C" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold"
                     Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Corax" Margin="0,18,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource Muted}"
                   Text="Заявки и справочник. Адрес панели и токен задаются здесь, для этого компьютера."/>

        <!-- Address and port share a row: they are one value, and it keeps the form short. -->
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Сервер" Style="{StaticResource FieldLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Порт" Style="{StaticResource FieldLabel}" Margin="10,0,0,6"/>
          <TextBox Grid.Row="1" Grid.Column="0" x:Name="HostBox" Style="{StaticResource Field}" Tag="192.168.1.10"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Style="{StaticResource Field}" Margin="10,0,0,0" Text="3000" Tag="3000"/>
        </Grid>

        <TextBlock Text="Токен" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
        <PasswordBox x:Name="TokenBox" Style="{StaticResource Secret}"/>

        <CheckBox x:Name="AutostartBox" Margin="0,16,0,0" IsChecked="True" Content="Запускать вместе с Windows"/>
        <Button x:Name="InstallButton" Margin="0,20,0,0" Style="{StaticResource PrimaryButton}" Content="Установить" Click="Install_Click"/>
        <ProgressBar x:Name="Bar" Margin="0,16,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
        <TextBlock x:Name="Status" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text=""/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
