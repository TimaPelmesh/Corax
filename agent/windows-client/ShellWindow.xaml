<Window x:Class="Corax.Client.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corax"
        Width="1040" Height="700"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="12,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceMuted}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PrimarySoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Primary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Root" CornerRadius="20" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
    <Grid>
      <Canvas IsHitTestVisible="False">
        <Ellipse x:Name="OrbA" Width="420" Height="420" Canvas.Left="-100" Canvas.Top="-140" Fill="{DynamicResource GlowA}"/>
        <Ellipse x:Name="OrbB" Width="320" Height="320" Canvas.Left="740" Canvas.Top="-60" Fill="{DynamicResource GlowB}"/>
      </Canvas>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="228"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="16,18">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" MouseLeftButtonDown="Drag">
              <TextBlock Text="Corax" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
              <Border Height="2" Margin="0,8,40,18" CornerRadius="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#93C5FD" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <TextBlock x:Name="HostLabel" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel>
              <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Content="Заявки" IsChecked="True" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavBook" Style="{StaticResource NavButton}" Content="Справочник" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavPc" Style="{StaticResource NavButton}" Content="Этот компьютер" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Настройки" Checked="Nav_Checked"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,16,22,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="Drag">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="—" Click="Min_Click" Style="{StaticResource ChromeButton}"/>
              <Button Content="×" Margin="4,0,0,0" Click="Close_Click" Style="{StaticResource ChromeButton}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="PageTitle" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Text="Заявки"/>
              <TextBlock x:Name="PageLead" Margin="0,2,0,0" Foreground="{DynamicResource Muted}" Text="Коротко, что случилось. Заявка уйдёт с этого компьютера."/>
            </StackPanel>
          </DockPanel>

          <Grid Grid.Row="1">
            <Grid x:Name="PageHome">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="16" Effect="{DynamicResource CardShadow}">
                <StackPanel>
                  <TextBlock Text="Тема" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="TitleBox" Style="{StaticResource Field}" Tag="Коротко, в одну строку"/>
                  <TextBlock Text="Описание" Style="{StaticResource FieldLabel}" Margin="2,12,0,6"/>
                  <TextBox x:Name="BodyBox" Style="{StaticResource FieldNote}" Tag="Что случилось"/>
                  <DockPanel Margin="0,12,0,0">
                    <TextBlock x:Name="FormNote" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="13"/>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Отправить" Style="{StaticResource PrimaryButton}" MinWidth="140" Click="Send_Click"/>
                  </DockPanel>
                </StackPanel>
              </Border>
              <DockPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Top" Margin="4,0,0,8" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Text="Мои заявки"/>
                <TextBlock x:Name="EmptyTickets" DockPanel.Dock="Top" Margin="4,8,0,8" Foreground="{DynamicResource Muted}" Text="С этого компьютера заявок пока нет." Visibility="Collapsed"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="TicketList"/>
                </ScrollViewer>
              </DockPanel>
            </Grid>

            <Grid x:Name="PageBook" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Tag="Имя, телефон, почта" TextChanged="Search_Changed"/>
              <TextBlock x:Name="EmptyPeople" Grid.Row="1" Margin="4,16,0,0" Foreground="{DynamicResource Muted}" Text="Справочник пуст. Телефоны появляются после синхронизации LDAP." Visibility="Collapsed"/>
              <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PeopleList"/>
              </ScrollViewer>
            </Grid>

            <StackPanel x:Name="PagePc" Visibility="Collapsed">
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="16" Effect="{DynamicResource CardShadow}">
                <StackPanel>
                  <TextBlock Text="Компьютер" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="PcName" Margin="0,4,0,12" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                  <TextBlock Text="Кто сейчас в системе" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="PcUser" Margin="0,4,0,12" Foreground="{DynamicResource Fg}"/>
                  <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="PcAddress" Margin="0,4,0,12" Foreground="{DynamicResource Fg}"/>
                  <TextBlock Text="Как панель видит заявки" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="PcRequester" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Fg}"/>
                </StackPanel>
              </Border>
              <Button x:Name="CollectButton" Margin="0,16,0,0" HorizontalAlignment="Left" Content="Снять инвентаризацию" Style="{StaticResource PrimaryButton}" Click="Collect_Click"/>
              <TextBlock x:Name="CollectNote" Margin="4,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13"/>
            </StackPanel>

            <StackPanel x:Name="PageSettings" Visibility="Collapsed">
              <TextBlock Text="Адрес панели" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="ServerBox" Style="{StaticResource Field}" Margin="0,0,0,14" Tag="http://panel:3000"/>
              <TextBlock Text="Ключ обработчика" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="SecretBox" Margin="0,0,0,14" Style="{StaticResource Secret}"/>
              <CheckBox x:Name="ThemeBox" Content="Тёмная тема" Foreground="{DynamicResource Fg}" Margin="0,0,0,10" Checked="Theme_Changed" Unchecked="Theme_Changed"/>
              <CheckBox x:Name="AutoBox" Content="Запускать вместе с Windows" Foreground="{DynamicResource Fg}" Margin="0,0,0,16"/>
              <Button Content="Сохранить" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
              Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="12" Padding="14,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="×" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Padding="6,0" Click="DismissToast"/>
          <TextBlock x:Name="ToastText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" MaxWidth="420"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
