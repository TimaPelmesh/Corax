# Copy to backend/.env — единственный файл секретов (local + Docker).
# Do not commit .env.
#
# Docker:
#   npm run docker:up
#   → scripts/ensure_docker_env.py создаст backend/.env с сильными секретами,
#     если файла ещё нет, и поднимет стек.
# После первого входа (admin / admin123) панель требует сменить пароль.
#
# Вручную:
#   cp backend/.env.example backend/.env
#   # заполните секреты ниже (или python scripts/ensure_docker_env.py)
#   npm run docker:up | docker:down | docker:restart

# --- Режим ---
# development | production | test
# В Docker Compose ENVIRONMENT принудительно production в контейнере.
ENVIRONMENT=development

# --- Обязательные секреты (production / Docker) ---
SECRET_KEY=generate-with-openssl-rand-hex-32
AGENT_TOKEN=long-random-string-for-agents-min-24-chars
AGENT_TOKEN_PEPPER=generate-with-openssl-rand-hex-32
BOOTSTRAP_ADMIN_USERNAME=admin
# Docker first raise: scripts/ensure_docker_env.py sets admin123 (change in panel later).
BOOTSTRAP_ADMIN_PASSWORD=admin123
# Optional: comma-separated old shared agent tokens during migration
# AGENT_LEGACY_TOKENS=

# CORS для панели (добавьте LAN IP: http://192.168.x.x:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Docker: IP хоста в LAN для сборки агентов (иначе контейнер видит только 172.x и поле будет пустым).
# Пример: CORAX_ADVERTISE_HOST=192.168.1.10
# Или откройте панель как http://192.168.x.x:3000 — IP подставится из адресной строки.
# CORAX_ADVERTISE_HOST=192.168.1.10

# --- PostgreSQL с хоста (pytest / инструменты против Docker-порта) ---
# Compose публикует 127.0.0.1:5433. Внутри контейнера URL подставляет docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://inventory:inventory@127.0.0.1:5433/inventory
DIAGRAMS_DATABASE_URL=postgresql+asyncpg://inventory:inventory@127.0.0.1:5433/inventory
WAREHOUSE_DATABASE_URL=postgresql+asyncpg://inventory:inventory@127.0.0.1:5433/inventory

# --- PostgreSQL: Docker Compose (сервис db) ---
POSTGRES_USER=inventory
# Docker first raise: default lab password (volume keeps it; never auto-rotated later).
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
POSTGRES_PUBLISH_PORT=127.0.0.1:5433
CORAX_PUBLISH_PORT=3000

# --- Backup sidecar (Docker) ---
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=3

# --- Hardening ---
# Пустой AGENT_INBOX_DIR = не писать сырые payload на диск
AGENT_INBOX_DIR=
ALLOW_LEGACY_AGENT_TOKEN_HASHES=false
ENABLE_OPENAPI=false
# ALLOW_DEV_ANY_AGENT_TOKEN=false
# WOL_FORCE_DISABLED=false
# Cookie/JWT lifetime (minutes). Default 1440 = 24h — удобно для LAN; для жёстче: 240–480.
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# SECURITY_HEADERS_ENABLED=true
# SECURITY_CSP_ENABLED=true

# --- Observability ---
# Куда пишутся логи:
#   1) stdout — Docker (`npm run docker:logs`)
#   2) файлы  — LOG_DIR/corax.jsonl (JSON) + LOG_DIR/corax.log (человекочитаемый)
# Local: backend/logs/   Docker: /data/logs (volume corax_data)
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_STDOUT=true
LOG_TO_FILE=true
# LOG_JSON=  (пусто = JSON в production, human в development для stdout)
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=14

# Rate limits (slowapi); disabled when ENVIRONMENT=test
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_AGENT=120/minute
# LAN-only form at /r. Keep disabled until deployed internally.
# SELF_SERVICE_ENABLED=false
# RATE_LIMIT_SELF_SERVICE=10/minute
# SELF_SERVICE_DEFAULT_CATEGORY=self-service
# RATE_LIMIT_WAKE=5/minute
# RATE_LIMIT_PING=30/minute

# Fleet ICMP
# COMPUTER_PING_ENABLED=true
# COMPUTER_PING_INTERVAL_MINUTES=15

# LDAP (directory sync only — not panel login)
# LDAP_URI=ldap://dc01.example.local
# LDAP_BIND_DN=CN=svc-inventory,OU=Service Accounts,DC=example,DC=local
# LDAP_BIND_PASSWORD=change-me
# LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=local

# Bitrix24
# BITRIX24_WEBHOOK_URL=https://your.bitrix24.ru/rest/1/xxxxxxxxxxxx
# BITRIX24_BOT_ID=
# BITRIX24_BOT_CLIENT_ID=
# BITRIX24_BOT_HANDLER_TOKEN=

# WikiRAG / local LLM (LM Studio or Ollama OpenAI-compatible /v1)
# LM Studio:  http://127.0.0.1:1234/v1
# Ollama:     http://127.0.0.1:11434/v1  (remote: http://192.168.x.x:11434/v1)
# LM_STUDIO_BASE_URL=http://127.0.0.1:11434/v1
# LM_STUDIO_DOCKER_URL=http://host.docker.internal:11434/v1
# For Ollama in Docker: LM_STUDIO_DOCKER_URL=http://host.docker.internal:11434/v1
# Рекомендуемо на GTX 1070 Ti 8GB: qwen2.5:7b (качество) или qwen2.5:3b (скорость).
# Не используйте gemma2:2b для CORAX/RAG — слишком слабая на больших таблицах.
# LM_STUDIO_MODEL=qwen2.5:7b
# LM_STUDIO_MAX_TOKENS=2048
# Контекст = Ollama num_ctx. 0 = авто (макс. модели до 32768). Вручную: 8192/16384/32768.
# WIKI_RAG_LM_CONTEXT_TOKENS=0
# WikiRAG classic RAG (как быстрый Ollama-скрипт): MD → chunk 1500/300 → bge-m3 → top-45.
# In Docker use host.docker.internal for a model on this PC; empty URL = same as LM_STUDIO_BASE_URL.
# WIKI_RAG_EMBED_BASE_URL=http://host.docker.internal:11434/v1
# WIKI_RAG_EMBED_MODEL=bge-m3
# WIKI_RAG_EMBED_DIMS=1024
# WIKI_RAG_CHUNK_SIZE=1500
# WIKI_RAG_CHUNK_OVERLAP=300
# WIKI_RAG_RETRIEVE_TOP_K=45
# WIKI_RAG_USE_TOOLS=false
# WIKI_RAG_CLASSIC_CONTEXT_CHARS=60000
# WIKI_RAG_CORAX_SYNC_MINUTES=0
# Автоиндексация при загрузке/правке (иначе только кнопка «Переиндексировать все»)
# WIKI_RAG_AUTO_INDEX=false
# ~1000–1200 Russian tokens per chunk; fewer embed calls than 500/100.
# WIKI_RAG_CHUNK_SIZE=1500
# WIKI_RAG_CHUNK_OVERLAP=300
# WIKI_RAG_RETRIEVE_TOP_K=45
# Disabled by default. Set a positive number only to explicitly enable
# automatic CORAX import and reindex (minutes).
# WIKI_RAG_CORAX_SYNC_MINUTES=0
# WIKI_RAG_USE_TOOLS=false
