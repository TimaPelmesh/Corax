{
  "private": true,
  "name": "corax",
  "version": "1.2.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && python -m pytest -q",
    "test:frontend": "npm run test --prefix frontend",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "docker:init": "node scripts/run_python.js scripts/ensure_docker_env.py",
    "docker:up": "node scripts/docker_up.js",
    "docker:rebuild": "node scripts/docker_up.js --force",
    "docker:down": "node scripts/docker_compose_env.js down",
    "docker:restart": "node scripts/docker_compose_env.js restart",
    "docker:logs": "node scripts/docker_compose_env.js logs -f",
    "docker:ps": "node scripts/docker_compose_env.js ps"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.0"
  }
}
